import random
import math

# ----------------------------
# TSP using Genetic Algorithm
# ----------------------------

def euclidean(a, b):
    return math.hypot(a[0] - b[0], a[1] - b[1])

def total_distance(route, coords):
    # route includes depot at both ends
    d = 0.0
    for i in range(len(route) - 1):
        d += euclidean(coords[route[i]], coords[route[i + 1]])
    return d

def fitness(route, coords):
    return 1.0 / total_distance(route, coords)

def order_crossover(parent1, parent2):
    n = len(parent1)
    start = random.randint(0, n - 1)
    end = random.randint(start, n - 1)

    child = [None] * n
    child[start:end + 1] = parent1[start:end + 1]

    remaining = [x for x in parent2 if x not in child]
    idx = 0
    for i in range(n):
        if child[i] is None:
            child[i] = remaining[idx]
            idx += 1
    return child

def swap_mutation(individual):
    i, j = random.sample(range(len(individual)), 2)
    individual[i], individual[j] = individual[j], individual[i]
    return individual

def initialize_population(pop_size, n_customers):
    population = []
    for _ in range(pop_size):
        route = list(range(1, n_customers + 1))
        random.shuffle(route)
        population.append(route)
    return population

def tournament_selection(population, coords):
    a = random.choice(population)
    b = random.choice(population)

    route_a = [0] + a + [0]
    route_b = [0] + b + [0]

    return a if fitness(route_a, coords) > fitness(route_b, coords) else b

def genetic_tsp(coords, pop_size=200, generations=500, mutation_rate=0.12):
    n_customers = len(coords) - 1
    population = initialize_population(pop_size, n_customers)

    best_route = None
    best_distance = float('inf')

    for gen in range(generations):
        scored = []
        for ind in population:
            full_route = [0] + ind + [0]
            dist = total_distance(full_route, coords)
            scored.append((ind, dist))

        scored.sort(key=lambda x: x[1])
        best_current = scored[0]

        if best_current[1] < best_distance:
            best_distance = best_current[1]
            best_route = best_current[0][:]

        new_population = [best_current[0][:]]

        while len(new_population) < pop_size:
            p1 = tournament_selection(population, coords)
            p2 = tournament_selection(population, coords)
            child = order_crossover(p1, p2)

            if random.random() < mutation_rate:
                child = swap_mutation(child)

            new_population.append(child)

        population = new_population

    final_route = [0] + best_route + [0]
    final_distance = total_distance(final_route, coords)

    return final_route, final_distance

# ----------------------------
# Colab Input
# ----------------------------

print("Enter the number of cities (including depot):")
n = int(input())

coords = []
print("Enter coordinates for each city (x y):")
for i in range(n):
    line = input().split()
    x, y = float(line[0]), float(line[1])
    coords.append((x, y))

print("\nProcessing TSP with Genetic Algorithm...\n")

best_route, best_distance = genetic_tsp(coords, pop_size=200, generations=500, mutation_rate=0.12)

print("=" * 50)
print("RESULTS")
print("=" * 50)
print(f"Best route (with depot): {best_route}")
print(f"Best distance: {round(best_distance, 4)}")
print("=" * 50)
